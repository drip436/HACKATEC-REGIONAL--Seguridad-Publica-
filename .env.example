# Copia este archivo a .env y reemplaza los valores. Nunca subas .env al repositorio.
# Genera secretos con: python -c "import secrets; print(secrets.token_urlsafe(48))"

# "desarrollo" (por defecto) o "produccion". En producción el arranque falla si
# falta el secreto JWT o alguna API key, en vez de quedar con endpoints abiertos.
SENTINEL_ENTORNO=desarrollo

# Firma de tokens X-Road (mínimo 32 caracteres). Sin él se usa uno efímero y los
# tokens dejan de verificarse al reiniciar.
SENTINEL_JWT_SECRET=
SENTINEL_JWT_TTL_SEGUNDOS=600

# Header X-Sensor-Key que envía el Módulo A (Edge AI) en POST /api/v1/eventos.
SENTINEL_SENSOR_API_KEY=
# Header X-Operador-Key para consola/operadores; en el WebSocket va como ?token=...
SENTINEL_OPERADOR_API_KEY=

SENTINEL_NODO_CENTRAL_ID=MX/GOB/TECNM/SENTINELOPS-CENTRAL
SENTINEL_AUTO_REGISTRAR_SENSORES=true
SENTINEL_WS_MAX_CONEXIONES=200
SENTINEL_TOLERANCIA_RELOJ_SEGUNDOS=300

# Solo "true" si la API está detrás de un proxy propio (nginx, etc.) que fija
# X-Forwarded-For. Si no, cualquier cliente podría falsear su IP en la bitácora.
SENTINEL_CONFIAR_PROXY=false

# --- Base de datos -----------------------------------------------------------
# Vacía = SQLite local (reflex.db). Para Supabase usa la cadena del "Session pooler":
#   Supabase → botón "Connect" (arriba) → pestaña "Connection String" → "Session pooler"
# Reemplaza [YOUR-PASSWORD] por la contraseña de la BD (no es la API key).
# Si la contraseña tiene símbolos (@ : / # ?), codifícalos: @ → %40, # → %23, etc.
# DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Sensor Edge AI (EDGE_AI/) ----------------------------------------------
# El sensor usa SENTINEL_SENSOR_API_KEY de arriba como X-Sensor-Key.
# Solo define esto si el backend no está en esta misma máquina/puerto:
# SENTINELOPS_BACKEND_URL=http://127.0.0.1:8000/api/v1/eventos
# Posición de la cámara si el sensor se ejecuta a mano (desde el panel se usa la del navegador).
# SENTINELOPS_LAT=17.987172
# SENTINELOPS_LNG=-92.919115

# --- Evidencias (fotos del sensor) ------------------------------------------
# Carpeta compartida sensor/backend, relativa a la raíz del repo (o absoluta).
# El backend la sirve en /static/capturas/<archivo> con la clave de operador
# (header X-Operador-Key o ?token=... para <img src>).
# SENTINEL_EVIDENCIAS_DIR=static/capturas
# Videos de demostración ya anotados (EDGE_AI/tools/preprocesar_video.py) y su índice camaras.json.
# SENTINEL_VIDEOS_DIR=static/videos
# --- Dashboard (frontend) ---
# "1" muestra datos simulados sin tocar la API ni la base de datos.
SENTINEL_MOCK=0
# Base de la API que consume el dashboard. Vacío = el backend de Reflex
# (http://localhost:8000), donde la API queda montada. Cámbialo si corres
# `reflex run` con otro --backend-port.
SENTINEL_API_URL=

# Video anotado del sensor Edge AI que muestra el panel (puerto 8090).
SENTINEL_EDGE_URL=http://localhost:8090
SENTINEL_STREAM_TOKEN=
# El sensor publica el video solo en la propia máquina (127.0.0.1). Para verlo
# desde otra máquina: SENTINELOPS_STREAM_HOST=0.0.0.0 y un token arriba.
# SENTINELOPS_STREAM_HOST=127.0.0.1
# SENTINELOPS_STREAM_PORT=8090

# --- Cámara vinculada y atención en campo ----------------------------------
# Intérprete con ultralytics/torch para el sensor que lanza el panel (por defecto, el del backend).
# SENTINEL_EDGE_PYTHON=/ruta/a/python
# Enrutador para que la patrulla siga las calles (servidor público de OSRM por defecto).
# SENTINEL_OSRM_URL=https://router.project-osrm.org
# Velocidad de la simulación en m/s (60 = ~6x una patrulla real, para la demo).
# SENTINEL_VELOCIDAD_DEMO_MPS=60
# Búsqueda de direcciones al vincular una cámara. Con esta llave se usa la Geocoding API
# de Google (mucho más precisa en calles y negocios); sin ella, OpenStreetMap. La llave
# solo la usa el backend. En Google Cloud: habilita "Geocoding API" y restringe la llave a esa API.
# GOOGLE_MAPS_API_KEY=
# La flota de patrullas vive en la tabla unidades_policiales (189 unidades de demostración
# en el Sur-Sureste, cargadas al iniciar). Edítala ahí para cambiar bases o agregar unidades.
