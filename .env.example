# Copia este archivo a .env y reemplaza los valores. Nunca subas .env al repositorio.
# Genera secretos con: python -c "import secrets; print(secrets.token_urlsafe(48))"

# "desarrollo" (por defecto) o "produccion". En producción el arranque falla si
# falta el secreto JWT o alguna API key, en vez de quedar con endpoints abiertos.
SENTINEL_ENTORNO=desarrollo

# Firma de tokens X-Road (mínimo 32 caracteres). Sin él se usa uno efímero y los
# tokens dejan de verificarse al reiniciar.
SENTINEL_JWT_SECRET=
SENTINEL_JWT_TTL_SEGUNDOS=600

# Header X-Sensor-Key que envía el Módulo A (Edge AI) en POST /api/v1/eventos.
SENTINEL_SENSOR_API_KEY=
# Header X-Operador-Key para consola/operadores; en el WebSocket va como ?token=...
SENTINEL_OPERADOR_API_KEY=

SENTINEL_NODO_CENTRAL_ID=MX/GOB/TECNM/SENTINELOPS-CENTRAL
SENTINEL_AUTO_REGISTRAR_SENSORES=true
SENTINEL_WS_MAX_CONEXIONES=200
SENTINEL_TOLERANCIA_RELOJ_SEGUNDOS=300

# Solo "true" si la API está detrás de un proxy propio (nginx, etc.) que fija
# X-Forwarded-For. Si no, cualquier cliente podría falsear su IP en la bitácora.
SENTINEL_CONFIAR_PROXY=false
